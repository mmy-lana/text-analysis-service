# API Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Cryptographic salt for HMAC-based API key and session hashing.
# REQUIRED in production (ENVIRONMENT=production refuses to start without it).
API_KEY_SALT=

# Rate Limiting
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=60
RATE_LIMIT_ANONYMOUS_PER_HOUR=20

# Database Configuration (Turso / LibSQL)
# For local development with Docker sqld:
DATABASE_URL=http://127.0.0.1:8080
DATABASE_AUTH_TOKEN=

# Frontend Configuration
# Leave unset to route same-origin /api requests through the Vite dev proxy.
PUBLIC_API_BASE_URL=http://localhost:8000
